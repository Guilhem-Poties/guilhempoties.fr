---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="mono muted">© {year} {site.name}</p>
    <ul class="links">
      {
        site.socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
      <li><a href="/mentions-legales/">Mentions légales</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 2rem;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    flex-wrap: wrap;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--text);
  }
</style>
