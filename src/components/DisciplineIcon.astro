---
// Guilhem's own hand-drawn line icons (see the "Création d'icônes" project), reused as discipline markers.
import { Image } from 'astro:assets';
import { disciplines, type Discipline } from '../lib/projects';

interface Props {
  discipline: Discipline;
  size?: number;
  class?: string;
}
const { discipline, size = 24, class: cls } = Astro.props;
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/icones/*.png', { eager: true });
const src = icons[`../assets/icones/${disciplines[discipline].icon}.png`]?.default;
---

{
  src && (
    <Image
      src={src}
      alt=""
      width={size * 2}
      class:list={['icon-img', cls]}
      style={`width:${size}px;height:${size}px`}
      loading="lazy"
    />
  )
}
