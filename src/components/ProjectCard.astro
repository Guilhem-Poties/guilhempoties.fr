---
import { Image } from 'astro:assets';
import DisciplineIcon from './DisciplineIcon.astro';
import { disciplineLabel, yearLabel, ytThumb, type Project } from '../lib/projects';

interface Props {
  project: Project;
  size?: 'default' | 'large';
  eager?: boolean;
  headingLevel?: 2 | 3;
}
const { project, size = 'default', eager = false, headingLevel = 3 } = Astro.props;
const { data } = project;
const primary = data.disciplines[0];
const video = data.videos[0];
const H = `h${headingLevel}` as 'h2' | 'h3';
const widths = size === 'large' ? [480, 800, 1200] : [400, 640, 900];
const sizes = size === 'large' ? '(max-width: 760px) 100vw, 66vw' : '(max-width: 760px) 100vw, 33vw';
---

<article class:list={['card', size]} data-disciplines={data.disciplines.join(' ')}>
  <a href={`/projets/${project.id}/`} class="link">
    <div class="media" transition:name={`media-${project.id}`}>
      {
        data.cover ? (
          <Image
            src={data.cover}
            alt={data.coverAlt ?? ''}
            widths={widths}
            sizes={sizes}
            loading={eager ? 'eager' : 'lazy'}
            class:list={['img', { contain: data.galleryFit === 'contain' && primary !== 'scene' }]}
          />
        ) : video ? (
          <img
            src={ytThumb(video.id)}
            alt=""
            width="480"
            height="360"
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            class="img"
            referrerpolicy="no-referrer"
          />
        ) : (
          <div class="placeholder" aria-hidden="true">
            <DisciplineIcon discipline={primary} size={size === 'large' ? 120 : 84} />
            <span class="ph-title">{data.title}</span>
          </div>
        )
      }
      {
        data.videos.length > 0 && (
          <span class="badge mono">
            <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true">
              <path d="M4 2.5v11l9-5.5z" fill="currentColor" />
            </svg>
            {data.videos.length > 1 ? `${data.videos.length} vidéos` : 'Vidéo'}
          </span>
        )
      }
    </div>
    <div class="body">
      <p class="meta mono">
        <span>{data.disciplines.map(disciplineLabel).join(' · ')}</span>
        <span>{yearLabel(project)}</span>
      </p>
      <H class="title">{data.title}</H>
      <p class="summary">{data.summary}</p>
    </div>
  </a>
</article>

<style>
  .card {
    min-width: 0;
  }
  .link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    text-decoration: none;
  }
  .link:hover {
    color: inherit;
  }
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .large .media {
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 601px) {
    /* The large card spans two grid rows: let its media grow to fill them. */
    .large .media {
      flex: 1;
      aspect-ratio: auto;
      min-height: 22rem;
    }
  }
  .img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.9s var(--ease),
      filter 0.6s var(--ease);
  }
  .img.contain {
    object-fit: contain;
    padding: 6%;
  }
  .link:hover .img {
    transform: scale(1.04);
  }
  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1rem, 3vw, 1.75rem);
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%),
      var(--surface);
    transition: transform 0.9s var(--ease);
  }
  .link:hover .placeholder {
    transform: scale(1.03);
  }
  .ph-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 1rem + 2vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .badge {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.65);
    color: #fff;
    font-size: 0.68rem;
    backdrop-filter: blur(6px);
  }
  .body {
    display: grid;
    gap: 0.4rem;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.7rem;
  }
  .title {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .large .title {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem);
  }
  .title {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.4s var(--ease);
    justify-self: start;
  }
  .link:hover .title {
    background-size: 100% 1px;
  }
  .summary {
    color: var(--muted);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
