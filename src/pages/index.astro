---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DisciplineIcon from '../components/DisciplineIcon.astro';
import { site } from '../data/site';
import { experiences, intro } from '../data/cv';
import { getProjects, getFeatured, countByDiscipline, disciplines, type Discipline } from '../lib/projects';
import portrait from '../assets/portrait/img-0696.jpg';

const projects = await getProjects();
const featured = await getFeatured();
const counts = countByDiscipline(projects);
const disciplineKeys = Object.keys(disciplines) as Discipline[];
const youtubeCount = projects.reduce((n, p) => n + p.data.videos.length, 0);
---

<Base>
  <!-- ───────────── Hero ───────────── -->
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow mono" data-reveal>Étudiant ingénieur IMAC · ESIEE Paris</p>
      <h1 class="name" data-reveal style="--delay:.05s">
        Guilhem<br /><span>Poties</span>
      </h1>
      <p class="lead" data-reveal style="--delay:.12s">
        <strong>Ingénieur créatif</strong>, entre le code et l'image. Je développe, je filme, je monte, je mixe — et je
        monte sur scène.
      </p>
      <div class="ctas" data-reveal style="--delay:.18s">
        <a class="btn btn-primary" href="/projets/">
          Voir mes créations
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
        </a>
        <a class="btn" href={site.cv} download>
          Télécharger mon CV
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v9M4 7l4 4 4-4M3 14h10" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
        </a>
      </div>
    </div>
    <figure class="hero-portrait" data-reveal style="--delay:.1s">
      <Image
        src={portrait}
        alt="Portrait de Guilhem Poties"
        widths={[360, 560, 800, 1100]}
        sizes="(max-width: 860px) 70vw, 34vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="mono">{site.location}</figcaption>
    </figure>
  </section>

  <!-- ───────────── Disciplines ───────────── -->
  <section class="container" aria-label="Disciplines">
    <ul class="disciplines">
      {
        disciplineKeys.map((d, i) => (
          <li data-reveal style={`--delay:${i * 0.04}s`}>
            <a href={`/projets/?d=${d}`}>
              <DisciplineIcon discipline={d} size={30} />
              <span class="d-label">{disciplines[d].label}</span>
              <span class="d-count mono">{String(counts[d]).padStart(2, '0')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ───────────── Sélection ───────────── -->
  <section class="section container" id="selection">
    <div class="section-head">
      <div>
        <p class="eyebrow mono">Sélection</p>
        <h2 class="h-section">Projets récents</h2>
      </div>
      <a class="arrow-link" href="/projets/">Toutes les créations ({projects.length}) <span>→</span></a>
    </div>
    <div class="featured">
      {
        featured.map((p, i) => (
          <div class:list={['f-item', `f-${i}`]} data-reveal style={`--delay:${(i % 3) * 0.06}s`}>
            <ProjectCard project={p} size={i === 0 ? 'large' : 'default'} eager={i === 0} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- ───────────── À propos ───────────── -->
  <section class="section about-wrap" id="a-propos">
    <div class="container about">
      <div>
        <p class="eyebrow mono">À propos</p>
        <h2 class="h-section">Passionné d'arts<br />et de sciences.</h2>
      </div>
      <div class="about-text">
        {intro.map((t) => <p>{t}</p>)}
        <dl class="stats">
          <div><dt class="mono muted">Projets</dt><dd>{projects.length}</dd></div>
          <div><dt class="mono muted">Vidéos publiées</dt><dd>{youtubeCount}</dd></div>
          <div><dt class="mono muted">Ans de théâtre</dt><dd>10</dd></div>
          <div><dt class="mono muted">Disciplines</dt><dd>{disciplineKeys.length}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ───────────── Parcours ───────────── -->
  <section class="section container" id="parcours">
    <div class="section-head">
      <div>
        <p class="eyebrow mono">Parcours</p>
        <h2 class="h-section">Expériences</h2>
      </div>
      <a class="arrow-link" href="/cv/">Parcours complet <span>→</span></a>
    </div>
    <ol class="timeline">
      {
        experiences.map((e) => (
          <li data-reveal>
            <span class="t-period mono muted">{e.period}</span>
            <div class="t-main">
              <h3>{e.href ? <a href={e.href}>{e.title}</a> : e.title}</h3>
              <p class="muted">{e.org}</p>
            </div>
            <p class="t-text">{e.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ───────────── Contact ───────────── -->
  <section class="section contact" id="contact">
    <div class="container">
      <p class="eyebrow mono">Contact</p>
      <h2 class="contact-title">Un projet, un stage,<br />une collaboration ?</h2>
      <a class="mail" href={`mailto:${site.email}?subject=Contact%20depuis%20guilhempoties.fr`}>
        {site.email}<span aria-hidden="true">↗</span>
      </a>
      <ul class="socials">
        {
          site.socials.map((s) => (
            <li>
              <a class="btn" href={s.href} target="_blank" rel="me noopener">
                {s.label}
              </a>
            </li>
          ))
        }
        <li><a class="btn" href={site.cv} download>CV (PDF)</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .name {
    font-size: clamp(3.4rem, 1.5rem + 9vw, 9.5rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    font-weight: 600;
  }
  .name span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text);
  }
  .lead {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 36ch;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    line-height: 1.45;
    color: var(--muted);
  }
  .lead strong {
    color: var(--text);
    font-weight: 600;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero-portrait {
    position: relative;
    margin: 0;
    justify-self: end;
    width: min(100%, 440px);
  }
  .hero-portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: calc(var(--radius) * 1.4);
    filter: grayscale(0.15) contrast(1.05);
  }
  .hero-portrait::after {
    content: '';
    position: absolute;
    top: -0.9rem;
    right: -0.9rem;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: var(--accent);
    mix-blend-mode: normal;
  }
  .hero-portrait figcaption {
    margin-top: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-portrait {
      justify-self: start;
      width: min(78%, 360px);
      order: -1;
    }
    .hero-portrait::after {
      right: -0.6rem;
      top: -0.6rem;
      width: 2.4rem;
      height: 2.4rem;
    }
  }

  /* Disciplines */
  .disciplines {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--line);
  }
  .disciplines li + li {
    border-left: 1px solid var(--line);
  }
  .disciplines a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    gap: 0.9rem 0.6rem;
    padding: 1.25rem 1rem;
    text-decoration: none;
    transition: background 0.3s var(--ease);
  }
  .disciplines a:hover {
    background: var(--surface);
    color: inherit;
  }
  .disciplines :global(.icon-img) {
    grid-column: 1 / -1;
    opacity: 0.85;
    transition: transform 0.4s var(--ease);
  }
  .disciplines a:hover :global(.icon-img) {
    transform: translateY(-3px) rotate(-6deg);
  }
  .d-label {
    font-family: var(--font-display);
    font-weight: 550;
  }
  .d-count {
    justify-self: end;
    color: var(--muted);
  }
  @media (max-width: 1000px) {
    .disciplines {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .disciplines li {
      border-bottom: 1px solid var(--line);
    }
    .disciplines li:nth-child(4n + 1) {
      border-left: 0;
    }
    .disciplines {
      border-bottom: 0;
    }
  }
  @media (max-width: 560px) {
    .disciplines {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .disciplines li:nth-child(n) {
      border-left: 0;
    }
    .disciplines li:nth-child(2n) {
      border-left: 1px solid var(--line);
    }
  }

  /* Featured grid */
  .featured {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.75rem);
  }
  .f-0 {
    grid-column: span 2;
    grid-row: span 2;
  }
  @media (max-width: 900px) {
    .featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .f-0 {
      grid-column: auto;
      grid-row: auto;
    }
  }

  /* About */
  .about-wrap {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  .about-text {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    font-size: 1.1rem;
  }
  .about-text > p:first-child {
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.45rem);
    line-height: 1.45;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .stats dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.5rem + 2vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .stats small {
    font-size: 0.45em;
    color: var(--muted);
    letter-spacing: 0;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  /* Timeline */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 0.5rem 2rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .t-period {
    padding-top: 0.3rem;
  }
  .t-main h3 {
    font-size: 1.3rem;
  }
  .t-main h3 a {
    text-decoration: none;
  }
  .t-main h3 a:hover {
    text-decoration: underline;
  }
  .t-main p {
    margin-top: 0.3rem;
    font-size: 0.95rem;
  }
  .t-text {
    color: var(--muted);
    font-size: 0.97rem;
  }
  @media (max-width: 860px) {
    .timeline li {
      grid-template-columns: 1fr;
    }
  }

  /* Contact */
  .contact {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(60% 80% at 100% 100%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%);
  }
  .contact-title {
    font-size: clamp(2.2rem, 1.3rem + 4vw, 5rem);
    letter-spacing: -0.04em;
  }
  .mail {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 0.8rem + 3.2vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--accent-ink);
    border-bottom: 2px solid currentColor;
    overflow-wrap: anywhere;
  }
  .mail:hover {
    color: var(--text);
  }
  .mail span {
    font-size: 0.6em;
    transition: transform 0.3s var(--ease);
  }
  .mail:hover span {
    transform: translate(3px, -3px);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
</style>
